{
  "name": "fingerprint-pro-server-api-openapi",
  "private": true,
  "version": "3.6.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "webpack-dev-server --open",
    "build": "webpack",
    "lintSchema": "vacuum lint ./schemas/*.yaml -d --errors --base schemas --ignore-file vacuum-ignore.yaml",
    "lintSchemaDist": "vacuum lint ./dist/schemas/*.yaml -d --errors --base dist/schemas --ignore-file vacuum-ignore.yaml",
    "schema:diff:published": "node ./scripts/schemaDiffPublished.js",
    "validateSchema": "node --experimental-strip-types ./bin/validateSchema.ts",
    "test": "vitest run",
    "test:dts": "echo 'No typescript tests' && exit 0",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "lint:changesets": "node scripts/lintChangesets.js",
    "prettier": "prettier . --check",
    "prettier:fix": "pnpm prettier . --write",
    "changeset": "node scripts/changeset.js",
    "changeset-version": "node scripts/zipChangesets.js && pnpm exec changeset version"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@fingerprint/node-sdk": "^7.5.0",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/conventional-changelog-dx-team": "^0.1.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.1.0",
    "@fingerprintjs/fingerprintjs-pro-server-api": "^6.12.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.1.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@quobix/vacuum": "^0.30.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/prompts": "^2.4.9",
    "@types/swagger-ui": "^5.32.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "express": "^5.2.1",
    "html-webpack-plugin": "^5.6.8",
    "js-yaml": "^5.2.3",
    "json-loader": "^0.5.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "style-loader": "^4.0.0",
    "swagger-ui": "^5.32.12",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "yaml": "^2.9.0",
    "yaml-loader": "^0.8.1",
    "zip-lib": "^1.4.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
